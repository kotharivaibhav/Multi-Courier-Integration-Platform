generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Admin Users ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  password     String     @db.VarChar(255)
  mobileNumber String     @unique @map("mobile_number") @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamp(0)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("users")
}

// ─── Courier & Shipment ─────────────────────────────────────────────────────

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RTO
}

enum BulkBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

enum CourierApiOperation {
  AUTH
  CREATE_SHIPMENT
  TRACK_SHIPMENT
  CANCEL_SHIPMENT
  WEBHOOK
}

model CourierPartner {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("courier_partners")
}

model ShipmentOrder {
  id              Int            @id @default(autoincrement())
  orderId         String         @unique @map("order_id") @db.VarChar(100)
  courierPartner  String         @map("courier_partner") @db.VarChar(50)
  courierOrderId  String?        @map("courier_order_id") @db.VarChar(100)
  awbNumber       String?        @map("awb_number") @db.VarChar(50)
  status          ShipmentStatus @default(CREATED)
  requestPayload  Json           @map("request_payload")
  responsePayload Json?          @map("response_payload")
  labelUrl        String?        @map("label_url") @db.Text
  batchId         String?        @map("batch_id") @db.VarChar(36)
  failureReason   String?        @map("failure_reason") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)

  trackingHistory ShipmentTrackingHistory[]
  apiLogs         CourierApiLog[]

  @@index([courierPartner])
  @@index([awbNumber])
  @@index([batchId])
  @@index([status])
  @@map("shipment_orders")
}

model ShipmentTrackingHistory {
  id          Int            @id @default(autoincrement())
  shipmentId  Int            @map("shipment_id")
  status      ShipmentStatus
  location    String?        @db.VarChar(255)
  description String?        @db.VarChar(500)
  rawPayload  Json           @map("raw_payload")
  eventAt     DateTime       @default(now()) @map("event_at") @db.Timestamp(0)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  shipment ShipmentOrder @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("shipment_tracking_history")
}

model BulkBatch {
  id           String          @id @default(uuid()) @db.VarChar(36)
  status       BulkBatchStatus @default(PENDING)
  totalCount   Int             @default(0) @map("total_count")
  successCount Int             @default(0) @map("success_count")
  failedCount  Int             @default(0) @map("failed_count")
  results      Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("bulk_batches")
}

model CourierApiLog {
  id             Int                 @id @default(autoincrement())
  shipmentId     Int?                @map("shipment_id")
  orderId        String?             @map("order_id") @db.VarChar(100)
  courierPartner String              @map("courier_partner") @db.VarChar(50)
  operation      CourierApiOperation
  requestPayload Json?               @map("request_payload")
  responsePayload Json?              @map("response_payload")
  httpStatus     Int?                @map("http_status")
  errorCode      String?             @map("error_code") @db.VarChar(50)
  errorMessage   String?             @map("error_message") @db.Text
  requestId      String?             @map("request_id") @db.VarChar(100)
  durationMs     Int?                @map("duration_ms")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)

  shipment ShipmentOrder? @relation(fields: [shipmentId], references: [id])

  @@index([orderId])
  @@index([courierPartner])
  @@index([shipmentId])
  @@map("courier_api_logs")
}

model WebhookEvent {
  id             Int      @id @default(autoincrement())
  courierPartner String   @map("courier_partner") @db.VarChar(50)
  awbNumber      String?  @map("awb_number") @db.VarChar(50)
  orderId        String?  @map("order_id") @db.VarChar(100)
  payload        Json
  processed      Boolean  @default(false)
  processedAt    DateTime? @map("processed_at") @db.Timestamp(0)
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([courierPartner])
  @@index([awbNumber])
  @@index([processed])
  @@map("webhook_events")
}
