service:
  name: "multi-courier-integration-platform"
  env: "local"
  shutdown_timeout: 20000
  before_shutdown_delay: 5000

http:
  port: "3000"

logging:
  level: info

cache:
  enabled: false

mysql:
  primary:
    host: 127.0.0.1
    port: "3306"
    username: root
    password: ''
    db_name: multi_courier
    connectionLimit: 30
    poolTimeout: 20
    connectTimeout: 10
  replica:
    host: 127.0.0.1
    port: "3306"
    username: root
    password: ''
    db_name: multi_courier
    connectionLimit: 30
    poolTimeout: 20
    connectTimeout: 10

redis:
  host: localhost
  port: 6379
  password: ''
  db: 0

bulk:
  maxOrders: 100
  concurrency: 10

auth:
  jwtSecret: "local-dev-jwt-secret-change-me"
  jwtExpiresInHours: 24
  bcryptSaltRounds: 12

couriers:
  urbanebolt:
    enabled: true
    baseUrl: "https://uat.urbanebolt.in"
    username: "info@urbanebolt.com"
    password: "EKIcygsLVV5RCtPZ"
    customerCode: "UEBCUS0008"
    csrfToken: "SuZfjeJQJQNlDaNxRJgaMqylRWlqogsL"
    sessionId: ""
    timeoutMs: 30000
    retryCount: 3
    retryBackoffMs: 1000
  mock:
    enabled: true
    simulatedDelayMs: 100
