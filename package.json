{
  "name": "multi-courier-integration-platform",
  "version": "1.0.0",
  "description": "Multi-courier logistics platform backend",
  "type": "commonjs",
  "scripts": {
    "dev": "rimraf dist && prisma generate && tsc && concurrently \"tsc --watch\" \"nodemon --watch src --ext ts --exec \\\"node dist/main.js\\\" --delay 500ms\"",
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "prisma:format": "npx prisma format",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@msgpack/msgpack": "^3.1.2",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "pino": "^9.7.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.3",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "schema": "prisma"
  }
}
